{
  "functions": {
    "api/*.py": {
      "excludeFiles": "{data/derived/results_classified_v2.json,data/normalized/normalized_latest.json,data/raw/results.json,results.json,ko/**,en/**,ja/**,impressum/**,img/**}"
    }
  },
  "rewrites": [
    {
      "source": "/dealer",
      "destination": "/api/dealer.py?r=app"
    },
    {
      "source": "/dealer/",
      "destination": "/api/dealer.py?r=app"
    },
    {
      "source": "/dealer/login",
      "destination": "/api/dealer.py?r=login"
    },
    {
      "source": "/dealer/logout",
      "destination": "/api/dealer.py?r=logout"
    },
    {
      "source": "/dealer/data",
      "destination": "/api/dealer.py?r=data"
    },
    {
      "source": "/dealer/password",
      "destination": "/api/dealer.py?r=password"
    },
    {
      "source": "/owner/dealers",
      "destination": "/api/owner_dealers.py"
    },
    {
      "source": "/owner/dealers/",
      "destination": "/api/owner_dealers.py"
    },
    {
      "source": "/owner/usage",
      "destination": "/api/owner_usage.py"
    },
    {
      "source": "/owner/usage/",
      "destination": "/api/owner_usage.py"
    },
    {
      "source": "/owner",
      "destination": "/api/owner_usage.py"
    },
    {
      "source": "/owner/",
      "destination": "/api/owner_usage.py"
    },
    {
      "source": "/Owner",
      "destination": "/api/owner_usage.py"
    },
    {
      "source": "/Owner/",
      "destination": "/api/owner_usage.py"
    },
    {
      "source": "/Owner/usage",
      "destination": "/api/owner_usage.py"
    },
    {
      "source": "/Owner/usage/",
      "destination": "/api/owner_usage.py"
    },
    {
      "source": "/OWNER/USAGE",
      "destination": "/api/owner_usage.py"
    },
    {
      "source": "/",
      "destination": "/beta.html"
    },
    {
      "source": "/search",
      "destination": "/beta.html"
    },
    {
      "source": "/qa",
      "destination": "/owner-qa.html"
    },
    {
      "source": "/beta",
      "destination": "/beta.html"
    },
    {
      "source": "/admin.html",
      "destination": "/app/templates/admin.html"
    },
    {
      "source": "/admin/normalization",
      "destination": "/api/normalization_admin_page.py"
    },
    {
      "source": "/qa.html",
      "destination": "/app/templates/qa.html"
    },
    {
      "source": "/api/telegram",
      "destination": "/api/telegram.py"
    },
    {
      "source": "/api/search",
      "destination": "/api/search.py"
    },
    {
      "source": "/api/normalization-auth",
      "destination": "/api/normalization_auth.py"
    },
    {
      "source": "/api/normalization-admin",
      "destination": "/api/normalization_admin.py"
    },
    {
      "source": "/data/:path*",
      "destination": "/data/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/data/dealer/:path*",
      "destination": "/dealer",
      "permanent": false
    },
    {
      "source": "/app/templates/dealer.html",
      "destination": "/dealer",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.camerabridge.io"
        }
      ],
      "destination": "https://camerabridge.io/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "camerabridge.vercel.app"
        }
      ],
      "destination": "https://camerabridge.io/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.camerabridge.io"
        }
      ],
      "destination": "https://camerabridge.io/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "camerabridge.vercel.app"
        }
      ],
      "destination": "https://camerabridge.io/:path*",
      "permanent": true
    }
  ]
}
